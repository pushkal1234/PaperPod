# Gemini Vision OCR: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq STT (Whisper): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: SerpAPI for Q&A "Document + Web" mode (free tier — https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your_serpapi_key_here

# Database (SQLite for demo)
DATABASE_URL=sqlite+aiosqlite:///./paperpod.db

# Audio storage
AUDIO_DIR=./audio_files

# Upload storage
UPLOAD_DIR=./uploads

# -- Auth --
JWT_SECRET=your_jwt_secret_here

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here

# -- Billing: Dodo Payments (Merchant of Record) --
# Leave blank to keep billing dark (checkout/portal return 503, nothing else
# changes). API key: Dodo dashboard -> Developer -> API Keys.
DODO_API_KEY=your_dodo_api_key_here
# Webhook signing secret: Developer -> Webhooks -> your endpoint (verifies the
# Standard Webhooks signature on every incoming webhook).
DODO_WEBHOOK_KEY=your_dodo_webhook_key_here
# Product id of the $5/mo Premium subscription: Products -> your product.
DODO_PRODUCT_ID=your_dodo_product_id_here
# "test_mode" (default) or "live_mode" — selects the Dodo API base URL.
DODO_ENVIRONMENT=live_mode
# Frontend base URL for post-checkout redirect (no trailing slash).
FRONTEND_BASE_URL=https://paper-pod-one.vercel.app

# -- Monetization switches (both default OFF; enable in Phase 2) --
# Master paywall kill-switch (enforcement gates read this).
# BILLING_ENABLED=0
# Require a signed-in account to upload (closes the anonymous loophole).
# REQUIRE_AUTH_UPLOAD=0

# -- Anti-abuse: email verification (default OFF) --
# Require a 6-digit code emailed at sign-up before an account can create
# podcasts. Closes the "type any fake email -> unlimited free podcasts" hole.
# Enabling this REQUIRES a provider below, else codes are only logged (dev).
# EMAIL_VERIFICATION_ENABLED=1
# VERIFICATION_CODE_TTL_MINUTES=15
# VERIFICATION_MAX_ATTEMPTS=5
# VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Provider option A — Resend (simplest): https://resend.com -> API Keys.
# RESEND_API_KEY=your_resend_api_key_here
# From header. Resend's sandbox sender works for testing without a domain;
# use a verified domain sender in production (e.g. "PaperPod <noreply@yourdomain.com>").
# EMAIL_FROM=PaperPod <onboarding@resend.dev>
# Provider option B — generic SMTP (used only if RESEND_API_KEY is blank).
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password

# -- Anti-abuse: per-IP free quota (default OFF, secondary defense) --
# Caps free podcasts per source IP across ALL accounts, so many fake accounts
# on one machine share one allowance. Premium users are never limited.
# IP_QUOTA_ENABLED=1
# FREE_PODCASTS_PER_IP=3

# -- Memory / runtime (read by glibc at process start, not by the app) --
# Keep idle RSS from plateauing after heavy PDF/vision/TTS jobs. ARENA_MAX caps
# per-thread malloc arenas (the threadpool creates many); TRIM_THRESHOLD_ makes
# glibc return freed memory to the OS sooner. The app also calls malloc_trim(0)
# after every job (see app/mem_utils.py). Set these in the deploy env (Railway).
MALLOC_ARENA_MAX=2
MALLOC_TRIM_THRESHOLD_=100000
